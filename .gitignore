# Obsidian workspace state (local only, do not publish)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/graph.json

# Obsidian cache
.obsidian/cache

# Interface skill links, created locally by link-skills.mjs.
# These are symlinks on Mac and Linux and directory junctions on Windows, so
# they carry absolute machine-specific paths and are meaningless in anyone
# else's clone. .claude/CLAUDE.md and .claude/settings.json still ship; only
# the generated link directories stay local.
.claude/skills/
.codex/skills/

# Runtime logs and working files.
# The starter primer ships; everything else the runtime writes stays local.
# Git will not descend into an ignored directory, so the wildcard plus a
# negation is the form that works. Plain ".runtime/" would hide primer.md too.
.runtime/*
!.runtime/primer.md

# Node dependencies
node_modules/

# Trash
.trash/

# OS files
.DS_Store
Thumbs.db

# Local environment files
.env
*.local

# Token replacement log (user-specific, generated on first run)
Council Chamber/scripts/replace-tokens-log.txt

# Local backup configuration
Council Chamber/scripts/backup.config.json

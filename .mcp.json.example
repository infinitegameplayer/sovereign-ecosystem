{
  "_readme": "Copy this file to .mcp.json and fill in the placeholder values before starting a session. See Getting Started/Optional Path - Obsidian MCP Bridge.md for full setup instructions. Never commit .mcp.json to version control; it contains secrets.",
  "mcpServers": {
    "obsidian": {
      "command": "npx",
      "args": [
        "-y",
        "@cyanheads/obsidian-mcp-server"
      ],
      "env": {
        "OBSIDIAN_API_KEY": "YOUR_LOCAL_REST_API_KEY_HERE",
        "OBSIDIAN_BASE_URL": "http://127.0.0.1:27124"
      }
    }
  }
}
